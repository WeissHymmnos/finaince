# Copy to .env (never commit the copy). Empty values stay unused.

# Required for `finaince serve` mutations and catalog/review reads.
FINAINCE_DESK_TOKEN=

# Optional alias of FINAINCE_DESK_TOKEN.
# FINAINCE_API_TOKEN=

# Default data backend is local. Set ricequant only when RQ_* are set.
FINAINCE_DATA_SOURCE=local

# PDF allowlist for HTTP reproduce. Required for POST /api/v1/reproduce.
# FINAINCE_PDF_ROOT=

# Prefer the wheel stub workbench over a sibling aiminer/frontend/dist.
# FINAINCE_PACKAGED_SPA=1

# Bind 0.0.0.0 / :: only when you also set this.
# FINAINCE_ALLOW_PUBLIC_BIND=1

# Comma-separated CORS origins. Default is localhost:8000 and :5173.
# FINAINCE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Author-tree sibling src injection. Off unless set.
# FINAINCE_PATH_HACK=1
# FINAINCE_NO_PATH_HACK=1

# Optional RiceQuant (live tests / --backend ricequant).
# RQ_TOKEN=
# RQ_USER=
# RQ_PASS=

# Chat LLM (no vendor is assumed). Mock reproduce does not need these.
# FINAINCE_LLM_PROVIDER=openai
# FINAINCE_LLM_MODEL=
# FINAINCE_LLM_API_KEY=
# FINAINCE_LLM_BASE_URL=
# Local OpenAI-compatible gateway (optional):
# ANTHROPIC_BASE_URL=http://127.0.0.1:8317
# ANTHROPIC_AUTH_TOKEN=
# Official vendor keys are also scanned when FINAINCE_LLM_PROVIDER is unset:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Opt-in live Claude Agent conversation tests.
# FINAINCE_LIVE_AGENT=1

# --- Research loop & model head ---
# Loop model head: ols (default) | gbm. gbm needs: uv pip install -e ".[gbm]"
# FINAINCE_MODEL_HEAD=ols
# Ask a chat LLM to pick loop actions; any failure falls back to the heuristic.
# FINAINCE_LOOP_ADVISOR=1

# --- Real-universe data track ---
# Point local eval at a full market panel (same columns as the shipped prices.parquet).
# FINAINCE_PANEL_PATH=
# Override the default backtest window (ISO dates).
# FINAINCE_BT_START=
# FINAINCE_BT_END=

# WS-C throughput
FINAINCE_PANEL_CACHE=on
FINAINCE_MAX_JOBS=2
# WS-E sandbox layer: bwrap | auto | off (auto uses bwrap when detected)
FINAINCE_SANDBOX=auto
# WS-J BRAIN external adjudication (optional; absent = honest internal-bench degradation)
# BRAIN_USER=
# BRAIN_PASS=
